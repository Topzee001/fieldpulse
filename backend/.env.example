SECRET_KEY=django-insecure-example-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL via Docker)
POSTGRES_DB=fieldpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-compatible File Storage) Configuration
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_STORAGE_BUCKET_NAME=fieldpulse
